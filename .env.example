# Copy to .env for the local Compose service. Do not commit the populated .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=procurement_agent
POSTGRES_USER=procurement_agent
POSTGRES_PASSWORD=change-me-local-only

# Optional Phase 3B live-Agent configuration. Leave OPENAI_API_KEY unset for
# deterministic scripted tests; do not commit a populated .env file.
OPENAI_API_KEY=
PROCUREMENT_AGENT_MODEL=gpt-5.6-luna
PROCUREMENT_AGENT_REASONING_EFFORT=low
